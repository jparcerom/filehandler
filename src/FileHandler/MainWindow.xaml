<Window x:Class="FileHandler.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FileHandler 2.0"
        Height="800"
        Width="900"
        MinHeight="700"
        MinWidth="720"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#F3F4F6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" Padding="30,22">
            <StackPanel>
                <TextBlock Text="FileHandler" FontSize="28" FontWeight="SemiBold" Foreground="#111827" />
                <TextBlock Text="Versión 2.0 · Organización de archivos multimedia"
                           Margin="0,4,0,0" FontSize="14" Foreground="#6B7280" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="30,24" MaxWidth="820" HorizontalAlignment="Left">
                <StackPanel x:Name="HomeView">
                    <TextBlock Text="¿Qué quieres hacer?" FontSize="21" FontWeight="SemiBold" Foreground="#111827" />
                    <TextBlock Text="Selecciona una operación para configurar sus carpetas y opciones."
                               Margin="0,8,0,22" TextWrapping="Wrap" Foreground="#4B5563" FontSize="14" />

                    <Button Click="OrganizeMedia_Click"
                            HorizontalContentAlignment="Stretch"
                            Background="White"
                            BorderBrush="#D1D5DB"
                            BorderThickness="1"
                            Padding="16"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="48"
                                    Height="48"
                                    Margin="0,4,16,0"
                                    VerticalAlignment="Top"
                                    Background="#EFF6FF"
                                    CornerRadius="24">
                                <Path Data="M4,5 H10 L12,7 H20 V19 H4 Z M6,17 L10,12 L13,15 L16,11 L20,16"
                                      Fill="Transparent"
                                      Stroke="#2563EB"
                                      StrokeThickness="1.6"
                                      StrokeLineJoin="Round"
                                      Margin="11" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Organizar archivos multimedia"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="#111827" />
                                <TextBlock Text="Selecciona la carpeta de tus fotografías y vídeos para organizarlos por año y mes y crear tu archivo cronológico. Puedes separar los vídeos de las imágenes o guardarlo todo en una misma carpeta."
                                           Margin="0,5,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="#4B5563" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button Click="FindMediaDuplicates_Click"
                            HorizontalContentAlignment="Stretch"
                            Background="White"
                            BorderBrush="#D1D5DB"
                            BorderThickness="1"
                            Padding="16"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="48"
                                    Height="48"
                                    Margin="0,4,16,0"
                                    VerticalAlignment="Top"
                                    Background="#FEF2F2"
                                    CornerRadius="24">
                                <Path Data="M8,4 H20 V18 H8 Z M5,7 H16 V21 H5 Z"
                                      Fill="Transparent"
                                      Stroke="#DC2626"
                                      StrokeThickness="1.6"
                                      StrokeLineJoin="Round"
                                      Margin="11" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Buscar duplicados multimedia"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="#111827" />
                                <TextBlock Text="Encuentra fotos y vídeos con contenido idéntico, revísalos y envía los seleccionados a la Papelera."
                                           Margin="0,5,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="#4B5563" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button Click="ExtractSubfolderFiles_Click"
                            HorizontalContentAlignment="Stretch"
                            Background="White"
                            BorderBrush="#D1D5DB"
                            BorderThickness="1"
                            Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="48"
                                    Height="48"
                                    Margin="0,4,16,0"
                                    VerticalAlignment="Top"
                                    Background="#ECFDF5"
                                    CornerRadius="24">
                                <Path Data="M4,6 H10 L12,8 H20 V18 H4 Z M11,13 H18 M15,10 L18,13 L15,16"
                                      Fill="Transparent"
                                      Stroke="#059669"
                                      StrokeThickness="1.6"
                                      StrokeLineJoin="Round"
                                      Margin="11" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Sacar archivos de subcarpetas"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="#111827" />
                                <TextBlock Text="Reunir los archivos en la raíz de una carpeta de destino."
                                           Margin="0,5,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="#4B5563" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </StackPanel>

                <StackPanel x:Name="MediaOrganizerView" Visibility="Collapsed">
                    <Button x:Name="MediaOrganizerBackButton"
                            Content="← Todas las operaciones"
                            HorizontalAlignment="Left"
                            Click="BackFromMediaOrganizer_Click"
                            Margin="0,0,0,14" />
                    <TextBlock Text="Organizar archivos multimedia" FontSize="21" FontWeight="SemiBold" Foreground="#111827" />
                    <TextBlock Text="Elige imágenes, vídeos o ambos. Se moverán a carpetas de año y mes usando la fecha más antigua entre creación y modificación."
                               Margin="0,6,0,12" TextWrapping="Wrap" Foreground="#4B5563" FontSize="14" />

                    <TextBlock Text="Carpeta de origen" FontWeight="SemiBold" Foreground="#374151" />
                    <DockPanel Margin="0,5,0,8">
                        <Button x:Name="SelectMediaOrganizerSourceButton"
                                DockPanel.Dock="Right"
                                Content="Seleccionar..."
                                Click="SelectMediaOrganizerSource_Click"
                                Margin="10,0,0,0" />
                        <TextBox x:Name="MediaOrganizerSourcePathTextBox" IsReadOnly="True" />
                    </DockPanel>

                    <ProgressBar x:Name="MediaOrganizerProgressBar" Height="10" Margin="0,5,0,5" Minimum="0" Maximum="100" />
                    <TextBlock x:Name="MediaOrganizerStatusTextBlock" Text="Selecciona la carpeta de origen para escanearla."
                               Foreground="#374151" TextWrapping="Wrap" />
                    <TextBlock x:Name="MediaOrganizerCountsTextBlock" Margin="0,5,0,12" Foreground="#111827" FontWeight="SemiBold" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <CheckBox x:Name="OrganizeImagesCheckBox"
                                      Content="Organizar imágenes"
                                      IsEnabled="False"
                                      Checked="MediaOrganizationSelection_Changed"
                                      Unchecked="MediaOrganizationSelection_Changed"
                                      FontWeight="SemiBold" />
                            <TextBlock Text="Destino de imágenes" Margin="0,8,0,4" Foreground="#374151" />
                            <DockPanel>
                                <Button x:Name="SelectImageOrganizationDestinationButton"
                                        DockPanel.Dock="Right"
                                        Content="Seleccionar..."
                                        Click="SelectImageOrganizationDestination_Click"
                                        IsEnabled="False"
                                        Margin="8,0,0,0" />
                                <TextBox x:Name="ImageOrganizationDestinationTextBox" IsReadOnly="True" />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <CheckBox x:Name="OrganizeVideosCheckBox"
                                      Content="Organizar vídeos"
                                      IsEnabled="False"
                                      Checked="MediaOrganizationSelection_Changed"
                                      Unchecked="MediaOrganizationSelection_Changed"
                                      FontWeight="SemiBold" />
                            <TextBlock Text="Destino de vídeos" Margin="0,8,0,4" Foreground="#374151" />
                            <DockPanel>
                                <Button x:Name="SelectVideoOrganizationDestinationButton"
                                        DockPanel.Dock="Right"
                                        Content="Seleccionar..."
                                        Click="SelectVideoOrganizationDestination_Click"
                                        IsEnabled="False"
                                        Margin="8,0,0,0" />
                                <TextBox x:Name="VideoOrganizationDestinationTextBox" IsReadOnly="True" />
                            </DockPanel>
                        </StackPanel>
                    </Grid>

                    <Button x:Name="OrganizeMediaButton"
                            Content="Organizar selección"
                            HorizontalAlignment="Left"
                            Background="#2563EB"
                            Foreground="White"
                            IsEnabled="False"
                            Click="StartMediaOrganization_Click"
                            Margin="0,14,0,0" />
                    <TextBlock x:Name="MediaOrganizationSummaryTextBlock" Margin="0,8,0,6" Foreground="#111827" FontWeight="SemiBold" />
                    <TextBlock Text="Registro de actividad" FontWeight="SemiBold" Foreground="#374151" />
                    <TextBox x:Name="MediaOrganizerLogTextBox"
                             Margin="0,5,0,0"
                             Height="100"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             FontSize="12" />
                    <TextBlock x:Name="MediaOrganizerLogPathTextBlock" Margin="0,5,0,0" Foreground="#6B7280" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel x:Name="SubfolderFilesView" Visibility="Collapsed">
                    <Button x:Name="SubfolderBackButton"
                            Content="← Todas las operaciones"
                            HorizontalAlignment="Left"
                            Click="BackFromSubfolderFiles_Click"
                            Margin="0,0,0,14" />
                    <TextBlock Text="Sacar archivos de subcarpetas"
                               FontSize="21"
                               FontWeight="SemiBold"
                               Foreground="#111827" />
                    <TextBlock Text="Mueve a la raíz del destino todos los archivos encontrados en subcarpetas. Los archivos que ya estén en la raíz del origen no se modifican. Si hay colisión, el entrante siempre recibe un sufijo incremental, aunque el contenido sea idéntico."
                               Margin="0,6,0,12"
                               TextWrapping="Wrap"
                               Foreground="#4B5563"
                               FontSize="14" />

                    <TextBlock Text="Carpeta de origen" FontWeight="SemiBold" Foreground="#374151" />
                    <DockPanel Margin="0,5,0,8">
                        <Button x:Name="SelectSubfolderSourceButton"
                                DockPanel.Dock="Right"
                                Content="Seleccionar..."
                                Click="SelectSubfolderSource_Click"
                                Margin="10,0,0,0" />
                        <TextBox x:Name="SubfolderSourcePathTextBox" IsReadOnly="True" />
                    </DockPanel>

                    <ProgressBar x:Name="SubfolderProgressBar" Height="10" Margin="0,5,0,5" Minimum="0" Maximum="100" />
                    <TextBlock x:Name="SubfolderStatusTextBlock"
                               Text="Selecciona la carpeta de origen para buscar archivos en sus subcarpetas."
                               Foreground="#374151"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="SubfolderCountsTextBlock"
                               Margin="0,5,0,12"
                               Foreground="#111827"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />

                    <TextBlock Text="Carpeta de destino" FontWeight="SemiBold" Foreground="#374151" />
                    <DockPanel Margin="0,5,0,12">
                        <Button x:Name="SelectSubfolderDestinationButton"
                                DockPanel.Dock="Right"
                                Content="Seleccionar..."
                                Click="SelectSubfolderDestination_Click"
                                IsEnabled="False"
                                Margin="10,0,0,0" />
                        <TextBox x:Name="SubfolderDestinationPathTextBox" IsReadOnly="True" />
                    </DockPanel>

                    <Button x:Name="MoveSubfolderFilesButton"
                            Content="Mover archivos a la raíz del destino"
                            HorizontalAlignment="Left"
                            Background="#2563EB"
                            Foreground="White"
                            IsEnabled="False"
                            Click="StartMoveSubfolderFiles_Click" />
                    <TextBlock x:Name="SubfolderSummaryTextBlock"
                               Margin="0,8,0,6"
                               Foreground="#111827"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock Text="Registro de actividad" FontWeight="SemiBold" Foreground="#374151" />
                    <TextBox x:Name="SubfolderLogTextBox"
                             Margin="0,5,0,0"
                             Height="100"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             FontSize="12" />
                    <TextBlock x:Name="SubfolderLogPathTextBlock"
                               Margin="0,5,0,0"
                               Foreground="#6B7280"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="0,1,0,0"
                Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="DateTextBlock"
                           VerticalAlignment="Center"
                           Foreground="#6B7280"
                           FontSize="12" />
                <TextBlock Grid.Column="1"
                           Text="FileHandler 2.0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="#374151"
                           FontSize="12" />
                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Foreground="#6B7280"
                           FontSize="12">
                    <Run Text="© jpmDevelope · " />
                    <Hyperlink NavigateUri="mailto:jpm.develope@gmail.com"
                               RequestNavigate="ContactHyperlink_RequestNavigate"
                               Foreground="#2563EB">jpm.develope@gmail.com</Hyperlink>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>
