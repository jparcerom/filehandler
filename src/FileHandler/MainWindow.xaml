<Window x:Class="FileHandler.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FileHandler 2.0"
        Height="760"
        Width="900"
        MinHeight="650"
        MinWidth="720"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#F3F4F6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" Padding="30,22">
            <StackPanel>
                <TextBlock Text="FileHandler" FontSize="28" FontWeight="SemiBold" Foreground="#111827" />
                <TextBlock Text="Versión 2.0 · Organización de archivos multimedia"
                           Margin="0,4,0,0" FontSize="14" Foreground="#6B7280" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="30,24" MaxWidth="820" HorizontalAlignment="Left">
                <StackPanel x:Name="HomeView">
                    <TextBlock Text="¿Qué quieres hacer?" FontSize="21" FontWeight="SemiBold" Foreground="#111827" />
                    <TextBlock Text="Selecciona una operación para configurar sus carpetas y opciones."
                               Margin="0,8,0,22" TextWrapping="Wrap" Foreground="#4B5563" FontSize="14" />

                    <Button Click="OrganizeByDate_Click"
                            HorizontalContentAlignment="Stretch"
                            Background="White"
                            BorderBrush="#D1D5DB"
                            BorderThickness="1"
                            Padding="16"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Organizar por fecha" FontSize="16" FontWeight="SemiBold" Foreground="#111827" />
                            <TextBlock Text="Mover archivos a carpetas por año y mes." Margin="0,5,0,0" Foreground="#4B5563" />
                            <TextBlock Text="DISPONIBLE" Margin="0,7,0,0" FontSize="11" FontWeight="Bold" Foreground="#15803D" />
                        </StackPanel>
                    </Button>

                    <Button Click="CopyMedia_Click"
                            HorizontalContentAlignment="Stretch"
                            Background="White"
                            BorderBrush="#D1D5DB"
                            BorderThickness="1"
                            Padding="16"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Copiar multimedia" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="Clasificar imágenes y vídeos por tipo y elegir destinos." Margin="0,5,0,0" />
                            <TextBlock Text="DISPONIBLE" Margin="0,7,0,0" FontSize="11" FontWeight="Bold" Foreground="#15803D" />
                        </StackPanel>
                    </Button>

                    <Button Click="MoveDuplicates_Click"
                            HorizontalContentAlignment="Stretch"
                            Background="White"
                            BorderBrush="#D1D5DB"
                            BorderThickness="1"
                            Padding="16"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Mover duplicados de Windows" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="Verificar duplicados nativos antes de moverlos." Margin="0,5,0,0" />
                            <TextBlock Text="DISPONIBLE" Margin="0,7,0,0" FontSize="11" FontWeight="Bold" Foreground="#15803D" />
                        </StackPanel>
                    </Button>

                    <Button Click="ExtractSubfolderFiles_Click"
                            HorizontalContentAlignment="Stretch"
                            Background="White"
                            BorderBrush="#D1D5DB"
                            BorderThickness="1"
                            Padding="16">
                        <StackPanel>
                            <TextBlock Text="Sacar archivos de subcarpetas" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="Reunir los archivos en la raíz de una carpeta de destino." Margin="0,5,0,0" />
                            <TextBlock Text="DISPONIBLE" Margin="0,7,0,0" FontSize="11" FontWeight="Bold" Foreground="#15803D" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel x:Name="DateOrganizerView" Visibility="Collapsed">
                    <Button x:Name="BackButton"
                            Content="← Todas las operaciones"
                            HorizontalAlignment="Left"
                            Click="BackToHome_Click"
                            Margin="0,0,0,20" />
                    <TextBlock Text="Organizar por fecha" FontSize="21" FontWeight="SemiBold" Foreground="#111827" />
                    <TextBlock Text="Mueve los archivos de la carpeta de origen a carpetas por año y mes, utilizando la fecha más antigua entre creación y modificación."
                               Margin="0,8,0,22" TextWrapping="Wrap" Foreground="#4B5563" FontSize="14" />

                    <TextBlock Text="Carpeta de origen" FontWeight="SemiBold" Foreground="#374151" />
                    <DockPanel Margin="0,7,0,18">
                        <Button x:Name="SelectSourceButton"
                                DockPanel.Dock="Right"
                                Content="Seleccionar..."
                                Click="SelectSource_Click"
                                Margin="10,0,0,0" />
                        <TextBox x:Name="SourcePathTextBox" IsReadOnly="True" ToolTip="Selecciona la carpeta que contiene los archivos." />
                    </DockPanel>

                    <TextBlock Text="Carpeta de destino" FontWeight="SemiBold" Foreground="#374151" />
                    <DockPanel Margin="0,7,0,22">
                        <Button x:Name="SelectDestinationButton"
                                DockPanel.Dock="Right"
                                Content="Seleccionar..."
                                Click="SelectDestination_Click"
                                Margin="10,0,0,0" />
                        <TextBox x:Name="DestinationPathTextBox" IsReadOnly="True" ToolTip="Selecciona dónde crear las carpetas de año y mes." />
                    </DockPanel>

                    <Button x:Name="StartButton"
                            Content="Iniciar organización"
                            HorizontalAlignment="Left"
                            Background="#2563EB"
                            Foreground="White"
                            Click="Start_Click" />
                    <ProgressBar x:Name="OperationProgressBar" Height="12" Margin="0,22,0,8" Minimum="0" Maximum="100" />
                    <TextBlock x:Name="StatusTextBlock" Text="Selecciona las carpetas de origen y destino para comenzar."
                               Foreground="#374151" TextWrapping="Wrap" />
                    <TextBlock x:Name="SummaryTextBlock" Margin="0,8,0,18" Foreground="#111827" FontWeight="SemiBold" />

                    <TextBlock Text="Registro de actividad" FontWeight="SemiBold" Foreground="#374151" />
                    <TextBox x:Name="LogTextBox"
                             Margin="0,8,0,0"
                             Height="120"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             FontSize="12" />
                    <TextBlock x:Name="LogPathTextBlock" Margin="0,8,0,0" Foreground="#6B7280" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel x:Name="MediaCopyView" Visibility="Collapsed">
                    <Button x:Name="MediaBackButton"
                            Content="← Todas las operaciones"
                            HorizontalAlignment="Left"
                            Click="BackFromMediaCopy_Click"
                            Margin="0,0,0,14" />
                    <TextBlock Text="Copiar multimedia" FontSize="21" FontWeight="SemiBold" Foreground="#111827" />
                    <TextBlock Text="Escanea la carpeta de origen y elige qué tipos de archivos copiar y a qué destinos."
                               Margin="0,6,0,12" TextWrapping="Wrap" Foreground="#4B5563" FontSize="14" />

                    <TextBlock Text="Carpeta de origen" FontWeight="SemiBold" Foreground="#374151" />
                    <DockPanel Margin="0,5,0,8">
                        <Button x:Name="SelectMediaSourceButton"
                                DockPanel.Dock="Right"
                                Content="Seleccionar..."
                                Click="SelectMediaSource_Click"
                                Margin="10,0,0,0" />
                        <TextBox x:Name="MediaSourcePathTextBox" IsReadOnly="True" />
                    </DockPanel>

                    <ProgressBar x:Name="MediaProgressBar" Height="10" Margin="0,5,0,5" Minimum="0" Maximum="100" />
                    <TextBlock x:Name="MediaStatusTextBlock" Text="Selecciona la carpeta de origen para escanearla."
                               Foreground="#374151" TextWrapping="Wrap" />
                    <TextBlock x:Name="MediaCountsTextBlock" Margin="0,5,0,12" Foreground="#111827" FontWeight="SemiBold" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <CheckBox x:Name="CopyImagesCheckBox"
                                      Content="Copiar imágenes"
                                      IsEnabled="False"
                                      Checked="MediaTypeSelection_Changed"
                                      Unchecked="MediaTypeSelection_Changed"
                                      FontWeight="SemiBold" />
                            <TextBlock Text="Destino de imágenes" Margin="0,8,0,4" Foreground="#374151" />
                            <DockPanel>
                                <Button x:Name="SelectImageDestinationButton"
                                        DockPanel.Dock="Right"
                                        Content="Seleccionar..."
                                        Click="SelectImageDestination_Click"
                                        IsEnabled="False"
                                        Margin="8,0,0,0" />
                                <TextBox x:Name="ImageDestinationTextBox" IsReadOnly="True" />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <CheckBox x:Name="CopyVideosCheckBox"
                                      Content="Copiar vídeos"
                                      IsEnabled="False"
                                      Checked="MediaTypeSelection_Changed"
                                      Unchecked="MediaTypeSelection_Changed"
                                      FontWeight="SemiBold" />
                            <TextBlock Text="Destino de vídeos" Margin="0,8,0,4" Foreground="#374151" />
                            <DockPanel>
                                <Button x:Name="SelectVideoDestinationButton"
                                        DockPanel.Dock="Right"
                                        Content="Seleccionar..."
                                        Click="SelectVideoDestination_Click"
                                        IsEnabled="False"
                                        Margin="8,0,0,0" />
                                <TextBox x:Name="VideoDestinationTextBox" IsReadOnly="True" />
                            </DockPanel>
                        </StackPanel>
                    </Grid>

                    <Button x:Name="CopyMediaButton"
                            Content="Iniciar copia"
                            HorizontalAlignment="Left"
                            Background="#2563EB"
                            Foreground="White"
                            IsEnabled="False"
                            Click="StartMediaCopy_Click"
                            Margin="0,14,0,0" />
                    <TextBlock x:Name="MediaSummaryTextBlock" Margin="0,8,0,6" Foreground="#111827" FontWeight="SemiBold" />
                    <Border x:Name="DeleteMediaSection"
                            Visibility="Collapsed"
                            Background="White"
                            BorderBrush="#D1D5DB"
                            BorderThickness="1"
                            Padding="12"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Eliminar originales (opcional)"
                                       FontWeight="SemiBold"
                                       Foreground="#111827" />
                            <TextBlock Text="Solo se eliminarán originales copiados que sigan coincidiendo con su destino. Los archivos no copiados o modificados se conservarán."
                                       Margin="0,4,0,8"
                                       TextWrapping="Wrap"
                                       Foreground="#4B5563" />
                            <CheckBox x:Name="DeleteImagesCheckBox"
                                      Content="Eliminar originales de imágenes"
                                      IsEnabled="False"
                                      Checked="MediaDeleteSelection_Changed"
                                      Unchecked="MediaDeleteSelection_Changed"
                                      Margin="0,2" />
                            <CheckBox x:Name="DeleteVideosCheckBox"
                                      Content="Eliminar originales de vídeos"
                                      IsEnabled="False"
                                      Checked="MediaDeleteSelection_Changed"
                                      Unchecked="MediaDeleteSelection_Changed"
                                      Margin="0,2" />
                            <Button x:Name="DeleteMediaButton"
                                    Content="Eliminar seleccionados"
                                    HorizontalAlignment="Left"
                                    IsEnabled="False"
                                    Click="DeleteCopiedMedia_Click"
                                    Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Registro de actividad" FontWeight="SemiBold" Foreground="#374151" />
                    <TextBox x:Name="MediaLogTextBox"
                             Margin="0,5,0,0"
                             Height="100"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             FontSize="12" />
                    <TextBlock x:Name="MediaLogPathTextBlock" Margin="0,5,0,0" Foreground="#6B7280" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel x:Name="WindowsDuplicatesView" Visibility="Collapsed">
                    <Button x:Name="DuplicatesBackButton"
                            Content="← Todas las operaciones"
                            HorizontalAlignment="Left"
                            Click="BackFromDuplicates_Click"
                            Margin="0,0,0,14" />
                    <TextBlock Text="Mover duplicados nativos de Windows"
                               FontSize="21"
                               FontWeight="SemiBold"
                               Foreground="#111827" />
                    <TextBlock Text="Solo se moverán archivos con sufijo numérico cuyo contenido coincida con el original o con el archivo numerado más bajo si falta el original."
                               Margin="0,6,0,12"
                               TextWrapping="Wrap"
                               Foreground="#4B5563"
                               FontSize="14" />

                    <TextBlock Text="Carpeta de origen" FontWeight="SemiBold" Foreground="#374151" />
                    <DockPanel Margin="0,5,0,10">
                        <Button x:Name="SelectDuplicatesSourceButton"
                                DockPanel.Dock="Right"
                                Content="Seleccionar..."
                                Click="SelectDuplicatesSource_Click"
                                Margin="10,0,0,0" />
                        <TextBox x:Name="DuplicatesSourcePathTextBox" IsReadOnly="True" />
                    </DockPanel>

                    <ProgressBar x:Name="DuplicatesProgressBar" Height="10" Margin="0,5,0,5" Minimum="0" Maximum="100" />
                    <TextBlock x:Name="DuplicatesStatusTextBlock"
                               Text="Selecciona la carpeta de origen para buscar duplicados."
                               Foreground="#374151"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="DuplicatesCountsTextBlock"
                               Margin="0,5,0,12"
                               Foreground="#111827"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />

                    <TextBlock Text="Carpeta de destino" FontWeight="SemiBold" Foreground="#374151" />
                    <DockPanel Margin="0,5,0,12">
                        <Button x:Name="SelectDuplicatesDestinationButton"
                                DockPanel.Dock="Right"
                                Content="Seleccionar..."
                                Click="SelectDuplicatesDestination_Click"
                                IsEnabled="False"
                                Margin="10,0,0,0" />
                        <TextBox x:Name="DuplicatesDestinationPathTextBox" IsReadOnly="True" />
                    </DockPanel>

                    <Button x:Name="MoveDuplicatesButton"
                            Content="Mover duplicados verificados"
                            HorizontalAlignment="Left"
                            Background="#2563EB"
                            Foreground="White"
                            IsEnabled="False"
                            Click="StartMoveDuplicates_Click" />
                    <TextBlock x:Name="DuplicatesSummaryTextBlock"
                               Margin="0,8,0,6"
                               Foreground="#111827"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock Text="Registro de actividad" FontWeight="SemiBold" Foreground="#374151" />
                    <TextBox x:Name="DuplicatesLogTextBox"
                             Margin="0,5,0,0"
                             Height="100"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             FontSize="12" />
                    <TextBlock x:Name="DuplicatesLogPathTextBlock"
                               Margin="0,5,0,0"
                               Foreground="#6B7280"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel x:Name="SubfolderFilesView" Visibility="Collapsed">
                    <Button x:Name="SubfolderBackButton"
                            Content="← Todas las operaciones"
                            HorizontalAlignment="Left"
                            Click="BackFromSubfolderFiles_Click"
                            Margin="0,0,0,14" />
                    <TextBlock Text="Sacar archivos de subcarpetas"
                               FontSize="21"
                               FontWeight="SemiBold"
                               Foreground="#111827" />
                    <TextBlock Text="Mueve a la raíz del destino todos los archivos encontrados en subcarpetas. Los archivos que ya estén en la raíz del origen no se modifican. Si hay colisión, el entrante siempre recibe un sufijo incremental, aunque el contenido sea idéntico."
                               Margin="0,6,0,12"
                               TextWrapping="Wrap"
                               Foreground="#4B5563"
                               FontSize="14" />

                    <TextBlock Text="Carpeta de origen" FontWeight="SemiBold" Foreground="#374151" />
                    <DockPanel Margin="0,5,0,8">
                        <Button x:Name="SelectSubfolderSourceButton"
                                DockPanel.Dock="Right"
                                Content="Seleccionar..."
                                Click="SelectSubfolderSource_Click"
                                Margin="10,0,0,0" />
                        <TextBox x:Name="SubfolderSourcePathTextBox" IsReadOnly="True" />
                    </DockPanel>

                    <ProgressBar x:Name="SubfolderProgressBar" Height="10" Margin="0,5,0,5" Minimum="0" Maximum="100" />
                    <TextBlock x:Name="SubfolderStatusTextBlock"
                               Text="Selecciona la carpeta de origen para buscar archivos en sus subcarpetas."
                               Foreground="#374151"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="SubfolderCountsTextBlock"
                               Margin="0,5,0,12"
                               Foreground="#111827"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />

                    <TextBlock Text="Carpeta de destino" FontWeight="SemiBold" Foreground="#374151" />
                    <DockPanel Margin="0,5,0,12">
                        <Button x:Name="SelectSubfolderDestinationButton"
                                DockPanel.Dock="Right"
                                Content="Seleccionar..."
                                Click="SelectSubfolderDestination_Click"
                                IsEnabled="False"
                                Margin="10,0,0,0" />
                        <TextBox x:Name="SubfolderDestinationPathTextBox" IsReadOnly="True" />
                    </DockPanel>

                    <Button x:Name="MoveSubfolderFilesButton"
                            Content="Mover archivos a la raíz del destino"
                            HorizontalAlignment="Left"
                            Background="#2563EB"
                            Foreground="White"
                            IsEnabled="False"
                            Click="StartMoveSubfolderFiles_Click" />
                    <TextBlock x:Name="SubfolderSummaryTextBlock"
                               Margin="0,8,0,6"
                               Foreground="#111827"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock Text="Registro de actividad" FontWeight="SemiBold" Foreground="#374151" />
                    <TextBox x:Name="SubfolderLogTextBox"
                             Margin="0,5,0,0"
                             Height="100"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             FontSize="12" />
                    <TextBlock x:Name="SubfolderLogPathTextBlock"
                               Margin="0,5,0,0"
                               Foreground="#6B7280"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
