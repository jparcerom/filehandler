<Window x:Class="FileHandler.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:FileHandler.Localization"
        Title="{loc:Translate Key=MainWindowTitle}"
        Height="800"
        Width="900"
        MinHeight="700"
        MinWidth="720"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#F3F4F6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" Padding="30,22">
            <StackPanel>
                <TextBlock Text="FileHandler" FontSize="28" FontWeight="SemiBold" Foreground="#111827" />
                <TextBlock Text="{loc:Translate Key=MainSubtitle}"
                           Margin="0,4,0,0" FontSize="14" Foreground="#6B7280" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="30,24" MaxWidth="820" HorizontalAlignment="Left">
                <StackPanel x:Name="HomeView">
                    <TextBlock Text="{loc:Translate Key=HomeQuestion}" FontSize="21" FontWeight="SemiBold" Foreground="#111827" />
                    <TextBlock Text="{loc:Translate Key=HomeInstruction}"
                               Margin="0,8,0,22" TextWrapping="Wrap" Foreground="#4B5563" FontSize="14" />

                    <Button Click="OrganizeMedia_Click"
                            HorizontalContentAlignment="Stretch"
                            Background="White"
                            BorderBrush="#D1D5DB"
                            BorderThickness="1"
                            Padding="16"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="48"
                                    Height="48"
                                    Margin="0,4,16,0"
                                    VerticalAlignment="Top"
                                    Background="#EFF6FF"
                                    CornerRadius="24">
                                <Path Data="M4,5 H10 L12,7 H20 V19 H4 Z M6,17 L10,12 L13,15 L16,11 L20,16"
                                      Fill="Transparent"
                                      Stroke="#2563EB"
                                      StrokeThickness="1.6"
                                      StrokeLineJoin="Round"
                                      Margin="11" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{loc:Translate Key=OrganizeTitle}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="#111827" />
                                <TextBlock Text="{loc:Translate Key=OrganizeDescription}"
                                           Margin="0,5,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="#4B5563" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button Click="FindMediaDuplicates_Click"
                            HorizontalContentAlignment="Stretch"
                            Background="White"
                            BorderBrush="#D1D5DB"
                            BorderThickness="1"
                            Padding="16"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="48"
                                    Height="48"
                                    Margin="0,4,16,0"
                                    VerticalAlignment="Top"
                                    Background="#FEF2F2"
                                    CornerRadius="24">
                                <Path Data="M8,4 H20 V18 H8 Z M5,7 H16 V21 H5 Z"
                                      Fill="Transparent"
                                      Stroke="#DC2626"
                                      StrokeThickness="1.6"
                                      StrokeLineJoin="Round"
                                      Margin="11" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{loc:Translate Key=DuplicatesTitle}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="#111827" />
                                <TextBlock Text="{loc:Translate Key=DuplicatesDescription}"
                                           Margin="0,5,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="#4B5563" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button Click="ExtractSubfolderFiles_Click"
                            HorizontalContentAlignment="Stretch"
                            Background="White"
                            BorderBrush="#D1D5DB"
                            BorderThickness="1"
                            Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="48"
                                    Height="48"
                                    Margin="0,4,16,0"
                                    VerticalAlignment="Top"
                                    Background="#ECFDF5"
                                    CornerRadius="24">
                                <Path Data="M4,6 H10 L12,8 H20 V18 H4 Z M11,13 H18 M15,10 L18,13 L15,16"
                                      Fill="Transparent"
                                      Stroke="#059669"
                                      StrokeThickness="1.6"
                                      StrokeLineJoin="Round"
                                      Margin="11" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{loc:Translate Key=ExtractTitle}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="#111827" />
                                <TextBlock Text="{loc:Translate Key=ExtractDescription}"
                                           Margin="0,5,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="#4B5563" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </StackPanel>

                <StackPanel x:Name="MediaOrganizerView" Visibility="Collapsed">
                    <Button x:Name="MediaOrganizerBackButton"
                            Content="{loc:Translate Key=BackToOperations}"
                            HorizontalAlignment="Left"
                            Click="BackFromMediaOrganizer_Click"
                            Margin="0,0,0,14" />
                    <TextBlock Text="{loc:Translate Key=OrganizeTitle}" FontSize="21" FontWeight="SemiBold" Foreground="#111827" />
                    <TextBlock Text="{loc:Translate Key=OrganizerDescription}"
                               Margin="0,6,0,12" TextWrapping="Wrap" Foreground="#4B5563" FontSize="14" />

                    <TextBlock Text="{loc:Translate Key=SourceFolder}" FontWeight="SemiBold" Foreground="#374151" />
                    <DockPanel Margin="0,5,0,8">
                        <Button x:Name="SelectMediaOrganizerSourceButton"
                                DockPanel.Dock="Right"
                                Content="{loc:Translate Key=SelectFolder}"
                                Click="SelectMediaOrganizerSource_Click"
                                Margin="10,0,0,0" />
                        <TextBox x:Name="MediaOrganizerSourcePathTextBox" IsReadOnly="True" />
                    </DockPanel>

                    <ProgressBar x:Name="MediaOrganizerProgressBar" Height="10" Margin="0,5,0,5" Minimum="0" Maximum="100" />
                    <TextBlock x:Name="MediaOrganizerStatusTextBlock" Text="{loc:Translate Key=SelectSourceToScan}"
                               Foreground="#374151" TextWrapping="Wrap" />
                    <TextBlock x:Name="MediaOrganizerCountsTextBlock" Margin="0,5,0,12" Foreground="#111827" FontWeight="SemiBold" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <CheckBox x:Name="OrganizeImagesCheckBox"
                                      Content="{loc:Translate Key=OrganizeImages}"
                                      IsEnabled="False"
                                      Checked="MediaOrganizationSelection_Changed"
                                      Unchecked="MediaOrganizationSelection_Changed"
                                      FontWeight="SemiBold" />
                            <TextBlock Text="{loc:Translate Key=ImageDestination}" Margin="0,8,0,4" Foreground="#374151" />
                            <DockPanel>
                                <Button x:Name="SelectImageOrganizationDestinationButton"
                                        DockPanel.Dock="Right"
                                        Content="{loc:Translate Key=SelectFolder}"
                                        Click="SelectImageOrganizationDestination_Click"
                                        IsEnabled="False"
                                        Margin="8,0,0,0" />
                                <TextBox x:Name="ImageOrganizationDestinationTextBox" IsReadOnly="True" />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <CheckBox x:Name="OrganizeVideosCheckBox"
                                      Content="{loc:Translate Key=OrganizeVideos}"
                                      IsEnabled="False"
                                      Checked="MediaOrganizationSelection_Changed"
                                      Unchecked="MediaOrganizationSelection_Changed"
                                      FontWeight="SemiBold" />
                            <TextBlock Text="{loc:Translate Key=VideoDestination}" Margin="0,8,0,4" Foreground="#374151" />
                            <DockPanel>
                                <Button x:Name="SelectVideoOrganizationDestinationButton"
                                        DockPanel.Dock="Right"
                                        Content="{loc:Translate Key=SelectFolder}"
                                        Click="SelectVideoOrganizationDestination_Click"
                                        IsEnabled="False"
                                        Margin="8,0,0,0" />
                                <TextBox x:Name="VideoOrganizationDestinationTextBox" IsReadOnly="True" />
                            </DockPanel>
                        </StackPanel>
                    </Grid>

                    <Button x:Name="OrganizeMediaButton"
                            Content="{loc:Translate Key=OrganizeSelection}"
                            HorizontalAlignment="Left"
                            Background="#2563EB"
                            Foreground="White"
                            IsEnabled="False"
                            Click="StartMediaOrganization_Click"
                            Margin="0,14,0,0" />
                    <TextBlock x:Name="MediaOrganizationSummaryTextBlock" Margin="0,8,0,6" Foreground="#111827" FontWeight="SemiBold" />
                    <TextBlock Text="{loc:Translate Key=ActivityLog}" FontWeight="SemiBold" Foreground="#374151" />
                    <TextBox x:Name="MediaOrganizerLogTextBox"
                             Margin="0,5,0,0"
                             Height="100"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             FontSize="12" />
                    <TextBlock x:Name="MediaOrganizerLogPathTextBlock" Margin="0,5,0,0" Foreground="#6B7280" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel x:Name="SubfolderFilesView" Visibility="Collapsed">
                    <Button x:Name="SubfolderBackButton"
                            Content="{loc:Translate Key=BackToOperations}"
                            HorizontalAlignment="Left"
                            Click="BackFromSubfolderFiles_Click"
                            Margin="0,0,0,14" />
                    <TextBlock Text="{loc:Translate Key=ExtractTitle}"
                               FontSize="21"
                               FontWeight="SemiBold"
                               Foreground="#111827" />
                    <TextBlock Text="{loc:Translate Key=SubfolderDescription}"
                               Margin="0,6,0,12"
                               TextWrapping="Wrap"
                               Foreground="#4B5563"
                               FontSize="14" />

                    <TextBlock Text="{loc:Translate Key=SourceFolder}" FontWeight="SemiBold" Foreground="#374151" />
                    <DockPanel Margin="0,5,0,8">
                        <Button x:Name="SelectSubfolderSourceButton"
                                DockPanel.Dock="Right"
                                Content="{loc:Translate Key=SelectFolder}"
                                Click="SelectSubfolderSource_Click"
                                Margin="10,0,0,0" />
                        <TextBox x:Name="SubfolderSourcePathTextBox" IsReadOnly="True" />
                    </DockPanel>

                    <ProgressBar x:Name="SubfolderProgressBar" Height="10" Margin="0,5,0,5" Minimum="0" Maximum="100" />
                    <TextBlock x:Name="SubfolderStatusTextBlock"
                               Text="{loc:Translate Key=SelectSourceToSearchSubfolders}"
                               Foreground="#374151"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="SubfolderCountsTextBlock"
                               Margin="0,5,0,12"
                               Foreground="#111827"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />

                    <TextBlock Text="{loc:Translate Key=DestinationFolder}" FontWeight="SemiBold" Foreground="#374151" />
                    <DockPanel Margin="0,5,0,12">
                        <Button x:Name="SelectSubfolderDestinationButton"
                                DockPanel.Dock="Right"
                                Content="{loc:Translate Key=SelectFolder}"
                                Click="SelectSubfolderDestination_Click"
                                IsEnabled="False"
                                Margin="10,0,0,0" />
                        <TextBox x:Name="SubfolderDestinationPathTextBox" IsReadOnly="True" />
                    </DockPanel>

                    <Button x:Name="MoveSubfolderFilesButton"
                            Content="{loc:Translate Key=MoveFilesToDestinationRoot}"
                            HorizontalAlignment="Left"
                            Background="#2563EB"
                            Foreground="White"
                            IsEnabled="False"
                            Click="StartMoveSubfolderFiles_Click" />
                    <TextBlock x:Name="SubfolderSummaryTextBlock"
                               Margin="0,8,0,6"
                               Foreground="#111827"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{loc:Translate Key=ActivityLog}" FontWeight="SemiBold" Foreground="#374151" />
                    <TextBox x:Name="SubfolderLogTextBox"
                             Margin="0,5,0,0"
                             Height="100"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             FontSize="12" />
                    <TextBlock x:Name="SubfolderLogPathTextBlock"
                               Margin="0,5,0,0"
                               Foreground="#6B7280"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="0,1,0,0"
                Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="DateTextBlock"
                           VerticalAlignment="Center"
                           Foreground="#6B7280"
                           FontSize="12" />
                <TextBlock Grid.Column="1"
                           Text="FileHandler 2.0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="#374151"
                           FontSize="12" />
                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Foreground="#6B7280"
                           FontSize="12">
                    <Run Text="© jpmDevelope · " />
                    <Hyperlink NavigateUri="mailto:jpm.develope@gmail.com"
                               RequestNavigate="ContactHyperlink_RequestNavigate"
                               Foreground="#2563EB">jpm.develope@gmail.com</Hyperlink>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>
