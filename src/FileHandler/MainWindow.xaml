<Window x:Class="FileHandler.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FileHandler 2.0"
        Height="760"
        Width="900"
        MinHeight="650"
        MinWidth="720"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#F3F4F6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" Padding="30,22">
            <StackPanel>
                <TextBlock Text="FileHandler" FontSize="28" FontWeight="SemiBold" Foreground="#111827" />
                <TextBlock Text="Versión 2.0 · Organización de archivos multimedia"
                           Margin="0,4,0,0" FontSize="14" Foreground="#6B7280" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30,24" MaxWidth="820" HorizontalAlignment="Left">
                <TextBlock Text="Organizar por fecha" FontSize="21" FontWeight="SemiBold" Foreground="#111827" />
                <TextBlock Text="Mueve los archivos de la carpeta de origen a carpetas por año y mes, utilizando la fecha más antigua entre creación y modificación."
                           Margin="0,8,0,22" TextWrapping="Wrap" Foreground="#4B5563" FontSize="14" />

                <TextBlock Text="Carpeta de origen" FontWeight="SemiBold" Foreground="#374151" />
                <DockPanel Margin="0,7,0,18">
                    <Button DockPanel.Dock="Right" Content="Seleccionar..." Click="SelectSource_Click" Margin="10,0,0,0" />
                    <TextBox x:Name="SourcePathTextBox" IsReadOnly="True" ToolTip="Selecciona la carpeta que contiene los archivos." />
                </DockPanel>

                <TextBlock Text="Carpeta de destino" FontWeight="SemiBold" Foreground="#374151" />
                <DockPanel Margin="0,7,0,22">
                    <Button DockPanel.Dock="Right" Content="Seleccionar..." Click="SelectDestination_Click" Margin="10,0,0,0" />
                    <TextBox x:Name="DestinationPathTextBox" IsReadOnly="True" ToolTip="Selecciona dónde crear las carpetas de año y mes." />
                </DockPanel>

                <Button x:Name="StartButton"
                        Content="Iniciar organización"
                        HorizontalAlignment="Left"
                        Background="#2563EB"
                        Foreground="White"
                        Click="Start_Click" />
                <ProgressBar x:Name="OperationProgressBar" Height="12" Margin="0,22,0,8" Minimum="0" Maximum="100" />
                <TextBlock x:Name="StatusTextBlock" Text="Selecciona las carpetas de origen y destino para comenzar."
                           Foreground="#374151" TextWrapping="Wrap" />
                <TextBlock x:Name="SummaryTextBlock" Margin="0,8,0,18" Foreground="#111827" FontWeight="SemiBold" />

                <TextBlock Text="Registro de actividad" FontWeight="SemiBold" Foreground="#374151" />
                <TextBox x:Name="LogTextBox"
                         Margin="0,8,0,0"
                         Height="260"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="12" />
                <TextBlock x:Name="LogPathTextBlock" Margin="0,8,0,0" Foreground="#6B7280" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
