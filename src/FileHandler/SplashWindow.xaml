<Window x:Class="FileHandler.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FileHandler"
        Width="480"
        Height="280"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent">
    <Border Background="White"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            CornerRadius="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="6" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#2563EB"
                    CornerRadius="16,16,0,0" />

            <StackPanel Grid.Row="1"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <TextBlock Text="FileHandler"
                           FontSize="34"
                           FontWeight="SemiBold"
                           Foreground="#111827"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="VersionTextBlock"
                           Margin="0,8,0,0"
                           FontSize="15"
                           Foreground="#6B7280"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <TextBlock Grid.Row="2"
                       Text="© jpmDevelope"
                       Margin="0,0,0,22"
                       FontSize="12"
                       Foreground="#6B7280"
                       HorizontalAlignment="Center" />
        </Grid>
    </Border>
</Window>
