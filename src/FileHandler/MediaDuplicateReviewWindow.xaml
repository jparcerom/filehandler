<Window x:Class="FileHandler.MediaDuplicateReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Buscar duplicados multimedia"
        Width="1100"
        Height="760"
        MinWidth="820"
        MinHeight="620"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Buscar duplicados multimedia"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="#111827" />
            <TextBlock Text="Se comparan imágenes y vídeos por tamaño y SHA-256 para detectar contenido idéntico, aunque los nombres sean distintos."
                       Margin="0,6,0,0"
                       TextWrapping="Wrap"
                       Foreground="#4B5563" />
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,16,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="SelectSourceButton"
                        Content="Seleccionar carpeta y buscar"
                        Click="SelectSource_Click"
                        Margin="8,0,0,0" />
                <Button x:Name="ScanAgainButton"
                        Content="Buscar de nuevo"
                        Click="ScanAgain_Click"
                        IsEnabled="False"
                        Margin="8,0,0,0" />
            </StackPanel>
            <TextBox x:Name="SourcePathTextBox"
                     IsReadOnly="True"
                     VerticalContentAlignment="Center" />
        </DockPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <ProgressBar x:Name="ScanProgressBar"
                         Height="8"
                         Minimum="0"
                         Maximum="100" />
            <DockPanel Margin="0,5,0,0">
                <TextBlock x:Name="StatusTextBlock"
                           Text="Selecciona una carpeta para buscar duplicados."
                           Foreground="#374151"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="CountsTextBlock"
                           DockPanel.Dock="Right"
                           Margin="12,0,0,0"
                           FontWeight="SemiBold"
                           Foreground="#111827"
                           TextAlignment="Right"
                           TextWrapping="Wrap" />
            </DockPanel>
        </StackPanel>

        <Grid Grid.Row="3">
            <Grid Margin="10">
                <TextBlock x:Name="DuplicateEmptyTextBlock"
                           Text="Todavía no hay resultados. Selecciona una carpeta para iniciar la búsqueda."
                           Foreground="#6B7280"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center" />
                <Grid x:Name="DuplicateResultsGrid" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ListBox x:Name="DuplicateGroupsListBox"
                             SelectionChanged="DuplicateGroups_SelectionChanged"
                             BorderBrush="#E5E7EB"
                             BorderThickness="1">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4">
                                    <TextBlock Text="{Binding DisplayText}"
                                               FontWeight="SemiBold"
                                               Foreground="#111827" />
                                    <TextBlock Text="{Binding HashPreview}"
                                               Margin="0,4,0,0"
                                               FontSize="11"
                                               Foreground="#6B7280" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <DataGrid x:Name="DuplicateFilesGrid"
                              Grid.Column="1"
                              Margin="10,0,0,0"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Enviar a papelera" Width="115">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelectedForDeletion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Vista previa" Width="90" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="68"
                                                Height="48"
                                                Background="#F3F4F6"
                                                CornerRadius="4">
                                            <Grid>
                                                <TextBlock Text="{Binding TypeIcon}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="#6B7280"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                                <Image Source="{Binding Thumbnail}"
                                                       Stretch="UniformToFill" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Archivo" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Path}"
                                                   ToolTip="{Binding Path}"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Tamaño"
                                                Binding="{Binding SizeText}"
                                                Width="95"
                                                IsReadOnly="True" />
                            <DataGridTextColumn Header="Tipo"
                                                Binding="{Binding TypeText}"
                                                Width="75"
                                                IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="4" Margin="0,12,0,0">
            <DockPanel>
                <Button x:Name="DeleteSelectedButton"
                        DockPanel.Dock="Right"
                        Content="Enviar selección a la Papelera"
                        Click="DeleteSelected_Click"
                        IsEnabled="False"
                        Background="#B91C1C"
                        Foreground="White" />
                <TextBlock x:Name="SelectionWarningTextBlock"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           Foreground="#B45309"
                           TextWrapping="Wrap" />
            </DockPanel>
            <TextBlock x:Name="SummaryTextBlock"
                       Margin="0,7,0,0"
                       FontWeight="SemiBold"
                       Foreground="#111827"
                       TextWrapping="Wrap" />
            <Expander Header="Registro de actividad"
                      Margin="0,5,0,0">
                <StackPanel>
                    <TextBox x:Name="ActivityLogTextBox"
                             Height="72"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             FontSize="12" />
                    <TextBlock x:Name="LogPathTextBlock"
                               Margin="0,4,0,0"
                               FontSize="11"
                               Foreground="#6B7280"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Expander>
        </StackPanel>
    </Grid>
</Window>
