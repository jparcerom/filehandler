<Window x:Class="FileHandler.MediaDuplicateReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:FileHandler.Localization"
        Title="{loc:Translate Key=DuplicateWindowTitle}"
        Width="1100"
        Height="760"
        MinWidth="820"
        MinHeight="620"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{loc:Translate Key=DuplicateWindowTitle}"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="#111827" />
            <TextBlock Text="{loc:Translate Key=DuplicateExplanation}"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap"
                       Foreground="#4B5563" />
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,16,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="SelectSourceButton"
                        Content="{loc:Translate Key=SelectFolderAndScan}"
                        Click="SelectSource_Click"
                        Margin="8,0,0,0" />
                <Button x:Name="ScanAgainButton"
                        Content="{loc:Translate Key=SearchAgain}"
                        Click="ScanAgain_Click"
                        IsEnabled="False"
                        Margin="8,0,0,0" />
            </StackPanel>
            <TextBox x:Name="SourcePathTextBox"
                     IsReadOnly="True"
                     VerticalContentAlignment="Center" />
        </DockPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <ProgressBar x:Name="ScanProgressBar"
                         Height="8"
                         Minimum="0"
                         Maximum="100" />
            <DockPanel Margin="0,5,0,0">
                <TextBlock x:Name="StatusTextBlock"
                           Text="{loc:Translate Key=SelectFolderForDuplicates}"
                           Foreground="#374151"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="CountsTextBlock"
                           DockPanel.Dock="Right"
                           Margin="12,0,0,0"
                           FontWeight="SemiBold"
                           Foreground="#111827"
                           TextAlignment="Right"
                           TextWrapping="Wrap" />
            </DockPanel>
        </StackPanel>

        <Grid Grid.Row="3" Margin="10">
            <TextBlock x:Name="DuplicateEmptyTextBlock"
                       Text="{loc:Translate Key=NoResultsYet}"
                       Foreground="#6B7280"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center" />
            <DataGrid x:Name="DuplicateFilesGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      LoadingRow="DuplicateFilesGrid_LoadingRow"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      Visibility="Collapsed">
                <DataGrid.RowStyle>
                    <Style TargetType="{x:Type DataGridRow}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsGroupSelectionInvalid}" Value="True">
                                <Setter Property="Background" Value="#FEE2E2" />
                                <Setter Property="Foreground" Value="#7F1D1D" />
                                <Setter Property="BorderBrush" Value="#DC2626" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="{loc:Translate Key=TrashColumn}" Width="115">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelectedForDeletion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{loc:Translate Key=IdenticalGroupColumn}" Width="240" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding GroupHeaderText}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#374151"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"
                                           Margin="4,2" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{loc:Translate Key=PreviewColumn}" Width="90" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Width="68"
                                        Height="48"
                                        Background="#F3F4F6"
                                        CornerRadius="4">
                                    <Grid>
                                        <TextBlock Text="{Binding TypeIcon}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="#6B7280"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                        <Image Source="{Binding Thumbnail}"
                                               Stretch="UniformToFill" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{loc:Translate Key=FileColumn}" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Path}"
                                           ToolTip="{Binding Path}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{loc:Translate Key=SizeColumn}"
                                        Binding="{Binding SizeText}"
                                        Width="95"
                                        IsReadOnly="True" />
                    <DataGridTextColumn Header="{loc:Translate Key=TypeColumn}"
                                        Binding="{Binding TypeText}"
                                        Width="75"
                                        IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <StackPanel Grid.Row="4" Margin="0,12,0,0">
            <DockPanel>
                <Button x:Name="DeleteSelectedButton"
                        DockPanel.Dock="Right"
                        Content="{loc:Translate Key=SendSelectionToRecycleBin}"
                        Click="DeleteSelected_Click"
                        IsEnabled="False"
                        Background="#B91C1C"
                        Foreground="White" />
                <Border x:Name="SelectionWarningBorder"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0"
                        Padding="0"
                        Background="Transparent"
                        CornerRadius="4">
                    <TextBlock x:Name="SelectionWarningTextBlock"
                               VerticalAlignment="Center"
                               Foreground="#B45309"
                               TextWrapping="Wrap" />
                </Border>
            </DockPanel>
            <TextBlock x:Name="SummaryTextBlock"
                       Margin="0,7,0,0"
                       FontWeight="SemiBold"
                       Foreground="#111827"
                       TextWrapping="Wrap" />
            <Expander Header="{loc:Translate Key=ActivityLog}"
                      Margin="0,5,0,0">
                <StackPanel>
                    <TextBox x:Name="ActivityLogTextBox"
                             Height="72"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             FontSize="12" />
                    <TextBlock x:Name="LogPathTextBlock"
                               Margin="0,4,0,0"
                               FontSize="11"
                               Foreground="#6B7280"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Expander>
        </StackPanel>
    </Grid>
</Window>
